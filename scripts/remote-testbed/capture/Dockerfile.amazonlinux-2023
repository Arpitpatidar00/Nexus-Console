# Amazon Linux 2023 with the docker CLI and PM2 (no systemd as PID 1).
FROM docker:29-cli AS cli
FROM amazonlinux:2023
RUN dnf install -y nodejs npm iproute procps-ng shadow-utils && npm install -g pm2@5 && dnf clean all
COPY --from=cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
RUN groupadd -g 2375 docker && useradd -m -s /bin/bash -G docker nexus
RUN printf 'require("http").createServer((q,s)=>s.end("ok")).listen(3000)\n' > /home/nexus/api.js \
 && printf 'process.exit(1)\n' > /home/nexus/worker.js && chown nexus /home/nexus/*.js
CMD ["sleep", "infinity"]
