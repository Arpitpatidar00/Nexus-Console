{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stackroost",
  "version": "0.1.0",
  "identifier": "com.vss.stackroost",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Stackroost",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 660,
        "dragDropEnabled": false,
        "visible": false,
        "transparent": true,
        "backgroundColor": "#141215",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "DeveloperTool",
    "copyright": "© 2026 Vidhya Skill School",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwODExRkU0QzZGMTZCOEMKUldTTWEvSEc1QitCUUJVeXRPNzkrdHp2dDRSaXZjRHRKR09MM2RhZjBOQTlMczZKbGVEMWhhNkEK",
      "endpoints": [
        "https://github.com/Arpitpatidar00/Stackroost/releases/latest/download/latest.json"
      ]
    }
  }
}
